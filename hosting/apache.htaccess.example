# Rename this file to `.htaccess` and upload it to your web root (the same folder as
# index.html) alongside the rest of the dist/ build output — it must sit at the root
# of the deployed site, not inside a subfolder.
#
# Requires:
#   - mod_rewrite  (for filesystem-first checks before 404 fallback)
#   - mod_headers  (security + cache headers — some shared hosts disable this by default)
#   - mod_deflate  (gzip/deflate compression — optional but recommended)
#   - mod_expires  (Expires header for cache-control — optional but recommended)
#
# Host-agnostic requirements mirrored from hosting/README.md (same as
# Netlify / Cloudflare / Nginx examples):
#   1. True HTTP 404 for unmatched paths (en → en/404.html, else 404.html)
#   2. Security headers on every response (HSTS max-age=86400 without includeSubDomains)
#
# ACTIVE HOST: Apache via GitHub Actions FTP (see .github/workflows/deploy.yml).
# Place this next to the built files from `npm run build` (dist/ contents).

DirectoryIndex index.html

# Locale-aware 404 bodies (real HTTP 404 status — not soft-404).
# Root default for Persian and non-/en paths. English overrides live in
# dist/en/.htaccess (written by scripts/prerender.mjs) via directory inheritance:
#   ErrorDocument 404 /en/404.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical apex; redirect old hostname only if it reaches this same Apache root.
  RewriteCond %{HTTP_HOST} ^www\.dbsstudio\.ir$ [NC,OR]
  RewriteCond %{HTTP_HOST} ^(www\.)?saeedzarrini\.ir$ [NC]
  RewriteRule ^ https://dbsstudio.ir%{REQUEST_URI} [R=301,L,NE]


  # Existing files and directories (prerendered HTML routes, assets, images, fonts)
  # must be served normally — only fall through to 404 when neither exists.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} ^/en(?:/|$)
  RewriteRule ^ - [R=404,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ - [R=404,L]
</IfModule>

# --- Compression (requires mod_deflate) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json \
    application/xml text/xml text/plain image/svg+xml font/woff2
</IfModule>

# --- Cache-control (requires mod_expires + mod_headers) ---
<IfModule mod_expires.c>
  ExpiresActive On
  # Vite-hashed assets: immutable for 1 year
  <FilesMatch "\.(js|css|woff2)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  # HTML: always revalidate
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Security headers (requires mod_headers) ---
<IfModule mod_headers.c>
  # Migration safety: short HSTS for the new apex, without includeSubDomains.
  Header set Strict-Transport-Security "max-age=86400"
  # Content-Security-Policy — generated at build by scripts/prerender.mjs (scripts/csp.mjs).
  # Do not hand-edit the Header line below; re-run `npm run build` to refresh script hashes.
  #   default-src 'self'              — deny by default; only same-origin unless overridden
  #   base-uri 'self'                 — restrict <base> targets
  #   object-src 'none'               — no plugins
  #   frame-ancestors 'none'          — clickjacking protection (pairs with X-Frame-Options)
  #   form-action 'self'              — same-origin form posts
  #   script-src 'self' 'sha256-…' …  — app bundles + FOUC/theme + JSON-LD (per-build SHA-256 hashes)
  #   style-src 'self' [+ hashes]     — bundled CSS only; inline style attrs removed from app
  #   img-src 'self' data: blob:      — site images + inline/data URLs
  #   font-src 'self' data:           — self-hosted @fontsource fonts (no Google Fonts CDN)
  #   connect-src 'self'              — contact form POST to /api/contact.php
  #   worker-src 'self' blob:         — PWA service worker + any blob workers
  #   manifest-src 'self'             — web app manifest
  #   upgrade-insecure-requests       — prefer HTTPS subresources
  Header set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://api.github.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests; script-src 'self' 'sha256-09jRdXqN2Xf4PNZvei2S6ZsjbWIEK1XwO8z4JVBIQ6M=' 'sha256-2CgJa885iO2C2ezif8NDoG4NN2juHHFHes3MY37vIUw=' 'sha256-3B6Vcs4DfL+MoBy3RY2grG/WFEFXt67+JQW0Lysi3GM=' 'sha256-4tmCTbRpqMNwM9xxBaa0L8UO0Vx0fe6s5mMEXXIjmXs=' 'sha256-5DO1QWHex49cYVA6UaUEnxX7NKZViJyq1daPUR6jGS8=' 'sha256-63XE6Wp0sIr2ZnQPSQTKH2K+2c9JUNn/oozS8B3Aj10=' 'sha256-66ldv3mKUGu2rxhuf0BWjp05Fa47gmKWYQbXdCmeflk=' 'sha256-7FWjXf/05/n9V6JP919vYNbKApIjImKYDrWQqT4/XiA=' 'sha256-8XktaQ9alAO1aMn1MPd47PAfprIwapPDpkfleWDZqwM=' 'sha256-CHQQzri1Mb1tuNFCRBQvYevjxAIQDPTg5dIVMa72Z9A=' 'sha256-CbHN/QJmTv0bRNDzuzY9E4BVn79mpg1aTdDbNRBsrIo=' 'sha256-D/aR4f5roStHqsFLeOv1iNceTLFWhiGEiEmTtbgF9fY=' 'sha256-DvkusBdIbcddvdoTg6gErDOGdiel8+uPQDJ505YiZSA=' 'sha256-Dyec9BPh5awIiFhC3B8xTAqtgcAHWHXMtrS+zPPy2fE=' 'sha256-EBzfvmRnS4drBqnD2Mp1mSU8cyYvO7C0yMPllgptq7I=' 'sha256-EgCPwp3mgiQ8GF+AMA3+iCkqBDYPimaULkIVGSx8dTk=' 'sha256-GX2V1c3WCvXB4oxA5VbuyRiQ+8VFPqN45yzvRqb+lpg=' 'sha256-Is+csSuoawxfYY0f8uDQSqy2j4+uMLqEUZB+FoC6pSU=' 'sha256-K3BNqoG2IxNbQfdhc28C3rdBPyuf5GiczZsTLV/WMSg=' 'sha256-K7D+CXkMf8mA5zwHCPwBV0obu1wXYzl3MTxQkVJsJYk=' 'sha256-L3whXbKdR9N8P1T3Ph/AZg9hsDfFrstXNUvcMdHJvcM=' 'sha256-M2qe2svPhxSSdorcHh51JY0MrJu2dGgCzmBIVyQMdH0=' 'sha256-OpLZNPceknEWjvqCzzGLXeFkOGkIsJOJeM/ymA0kjzg=' 'sha256-OyPQnemBaV9GQY+ozKIMOn5XLJBVvz8iCTNVfr2/A0s=' 'sha256-PwXpA/KBPp7v5KBKA1xurwtsqrEtLbAXw5fogJ4lytY=' 'sha256-QdP8hbUinqS7OutvgoioBLMRdJIOh9B+o4DWvKMxFY8=' 'sha256-Qv2XnZlZMSuyBo2P6enzniBv5+qP5rH7Na6l5BmBN9I=' 'sha256-ST9RHk20i+VQsWefwRwuKzaCOIH2lWmzynpAnLNvV3c=' 'sha256-SWJbhObI7Hpl8EdY6PlAOthlaSGWTgKou6Mieppkm/M=' 'sha256-SqDiY3iIdHMUFsyCJPCv6L7lFE44XQw0400nZd7V1X0=' 'sha256-T9xay0WWC7jcX9CMjh4ojGU2+Mk0jGG3Tcw/UsDcPFo=' 'sh