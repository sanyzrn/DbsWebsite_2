# host-specific deployment config — replace with the equivalent for a new host if migrating
# ACTIVE HOST today is Apache FTP. Use this snippet when serving `dist/` via Nginx.

# Canonical host (temporary provider subdomain → apex). Adjust server_name as needed.
# server {
#   listen 443 ssl http2;
#   server_name preview.example.com;
#   return 301 https://dbsstudio.ir$request_uri;
# }

server {
  listen 443 ssl http2;
  server_name dbsstudio.ir;
  root /var/www/saeedzarrini/dist;   # ← point at the built `dist/` folder
  index index.html;

  # --- Security headers (no HSTS until the permanent host is locked in) ---
  # CSP: self + Formspree; inline script/style for FOUC bootstrap + JSON-LD; self-hosted fonts
  add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests; script-src 'self' 'sha256-09jRdXqN2Xf4PNZvei2S6ZsjbWIEK1XwO8z4JVBIQ6M=' 'sha256-2CgJa885iO2C2ezif8NDoG4NN2juHHFHes3MY37vIUw=' 'sha256-3B6Vcs4DfL+MoBy3RY2grG/WFEFXt67+JQW0Lysi3GM=' 'sha256-4tmCTbRpqMNwM9xxBaa0L8UO0Vx0fe6s5mMEXXIjmXs=' 'sha256-5DO1QWHex49cYVA6UaUEnxX7NKZViJyq1daPUR6jGS8=' 'sha256-7ctRBIIfvVxsZy272udErALuZBzCGWoRSffvsWqBgcw=' 'sha256-CHQQzri1Mb1tuNFCRBQvYevjxAIQDPTg5dIVMa72Z9A=' 'sha256-CbHN/QJmTv0bRNDzuzY9E4BVn79mpg1aTdDbNRBsrIo=' 'sha256-D/aR4f5roStHqsFLeOv1iNceTLFWhiGEiEmTtbgF9fY=' 'sha256-DvkusBdIbcddvdoTg6gErDOGdiel8+uPQDJ505YiZSA=' 'sha256-EgCPwp3mgiQ8GF+AMA3+iCkqBDYPimaULkIVGSx8dTk=' 'sha256-GX2V1c3WCvXB4oxA5VbuyRiQ+8VFPqN45yzvRqb+lpg=' 'sha256-Is+csSuoawxfYY0f8uDQSqy2j4+uMLqEUZB+FoC6pSU=' 'sha256-K7D+CXkMf8mA5zwHCPwBV0obu1wXYzl3MTxQkVJsJYk=' 'sha256-L3whXbKdR9N8P1T3Ph/AZg9hsDfFrstXNUvcMdHJvcM=' 'sha256-M2qe2svPhxSSdorcHh51JY0MrJu2dGgCzmBIVyQMdH0=' 'sha256-MDLAI6Cm+Y4x2b6lJpE/+kI252EEGd9dCyot4FmpKX8=' 'sha256-OpLZNPceknEWjvqCzzGLXeFkOGkIsJOJeM/ymA0kjzg=' 'sha256-OyPQnemBaV9GQY+ozKIMOn5XLJBVvz8iCTNVfr2/A0s=' 'sha256-PwXpA/KBPp7v5KBKA1xurwtsqrEtLbAXw5fogJ4lytY=' 'sha256-QdP8hbUinqS7OutvgoioBLMRdJIOh9B+o4DWvKMxFY8=' 'sha256-SWJbhObI7Hpl8EdY6PlAOthlaSGWTgKou6Mieppkm/M=' 'sha256-SqDiY3iIdHMUFsyCJPCv6L7lFE44XQw0400nZd7V1X0=' 'sha256-T9xay0WWC7jcX9CMjh4ojGU2+Mk0jGG3Tcw/UsDcPFo=' 'sha256-TGA1PRYxbfc2msvUtX8tK+tgM6vBqx8W1oHaomb+OnY=' 'sha256-UY9TGfG0vwkdVawYD7/iMPNfeSKxvplY4Yc2ndIRgKU=' 'sha256-WOhdmpzAXQi851v/hLUaS2LzuDFbcRWeQgDLQc/KfPA=' 'sha256-ZCCKOHiEuW61VDFKdF9CTfKygrKL0QvrNboaH/nsMBo=' 'sha256-Ze2pLyRgOvNDzGeA3cI1e3021rE8ZW0RzwCcNgro9BY=' 'sha256-ZgHSyD1t5Ti7zv86WBwcIuJ5pO7JZzffRYZ7OBudIAY=' 'sha256-ZvK/LUHTRP2Xq/vQgwQLj7lpkrR7KuJSDNZxDD1QhYQ=' 'sha256-ael8XxzH4uBQQTDMKB8EYs+e7R6DWieGl2pZStZ8b0s=' 'sha256-aoKmi3qH2d8NmjhubNDQduoMfMvwq1Tpz3YATw8/Pjw=' 'sha256-cu1XYEfwVuiObcttZWCxXlWVmjFICVNbTCg1qFmoG1k=' 'sha256-dITrprWqGM6Ej+oqknhr4/PtVDAtSit3n0fdEwpwkec=' 'sha256-g9+AhXZXsDEeMSM0XgjDZopG5iRmKxeI41n3xUSWFTs=' 'sha256-h+bLZtq5AszT8/8vd8WPMIX2nhw+uuQ09M9Qc7kj/v4=' 'sha256-iWZ7vPSHwQ6noP6tuOwaTWvFqQVnsd3jLGqTtv/QpCM=' 'sha256-igGtcZCBVRbaD9fxcCeI+30LK3M3SBzNP31shMtHbw8=' 'sha256-kAghxiWaSZBj5X905bI/lKt1IAqhLu4uP3lEXbaVKd0=' 'sha256-kFNuR/MDBzBlr9lPTY6+4VR+wvp/Z8lMreqnqjycXQ8=' 'sha256-klc6Ioy2St2kWwAt37foWsaNGb5KA/yA3wXHd8MKTNg=' 'sha256-m2QGKpnzKQEqVSnYbU5GUTBS7LzTgtWirl9E6OhyCOY=' 'sha256-mY+dJDGBcXfs0m53jgqVa/iqisLrTP617VI+F5X9qPA=' 'sha256-nwpRsb5UU6bDw4JQxXTBzA7jzqzlaKzttr52DUBxgus=' 'sha256-p/O9ZV1bTM1TT5PXyPeYsLKCyc512LoPrYBdTSxcpyo=' 'sha256-syg8BY6JvP9AB1x8cim5GrVTB1f95Xi1DOJtvE99YD8=' 'sha256-szODq9MpKGzxVGB+w+iXVUlqMTieoOJ0+gZxzSHEsuI=' 'sha256-tntzJ0Qceze5qV+bXoftyDqWxzqOyXPBC0fYgDq0vnw=' 'sha256-vE0dXl361V5Abu+3Av0ODF2+bledeve8ZyHLT5uz2jE=' 'sha256-vWRKbJyzIDSX6Ts2lugf4WcDRBdwApt3dWCTpApBc48=' 'sha256-wT6fVCq8ABfGHNTS/QLEqOb1993BaifoJCF7Zp6ClGg=' 'sha256-xBXiklOOgxAkGdJBpVlgfXgDWomw7yemGis4PMmQxa0=' 'sha256-xZU4LRPUJXtVwLFHP14gu0iK1JMQFUYB1/XblLEaH/8=' 'sha256-yGiycva1my2TtnrcvnUxpCKFIdRyDdADv+Rxgo6araw='; style-src 'self'" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()" always;
  add_header X-Frame-Options "DENY" always;

  # Prefer exact files / clean URLs (no trailing slash)
  try_files $uri $uri/ $uri.html =404;

  # True 404 status with locale-aware bodies
  error_page 404 /404.html;
  location = /404.html {
    internal;
  }

  # English unmatched paths should use the English 404 document
  location ^~ /en/ {
    try_files $uri $uri/ $uri.html /en/404.html;
    error_page 404 /en/404.html;
  }

  location = /en/404.html {
    internal;
  }
}
