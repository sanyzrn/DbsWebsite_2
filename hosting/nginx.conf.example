# host-specific deployment config — replace with the equivalent for a new host if migrating
# ACTIVE HOST today is Apache FTP. Use this snippet when serving `dist/` via Nginx.

# Canonical host (temporary provider subdomain → apex). Adjust server_name as needed.
# server {
#   listen 443 ssl http2;
#   server_name preview.example.com;
#   return 301 https://saeedzarrini.ir$request_uri;
# }

server {
  listen 443 ssl http2;
  server_name saeedzarrini.ir;
  root /var/www/saeedzarrini/dist;   # ← point at the built `dist/` folder
  index index.html;

  # --- Security headers (no HSTS until the permanent host is locked in) ---
  # CSP: self + Formspree; inline script/style for FOUC bootstrap + JSON-LD; self-hosted fonts
  add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests; script-src 'self' 'sha256-/80F0N8Vd++AoH6g/cEPufTf2fAMdrZHhtkVe+LHWys=' 'sha256-1TyTUiUQaYnUOSkxfWN/m2BQXkyVQi80O22kk9Fe5e0=' 'sha256-3PJL770nvSKu5HXtesuoVeDLPw7riZDp9/mB1uFNUiw=' 'sha256-8St1i8fCnLqTaHba1ndVXDmVUBwyya5nQIPknB/MMSE=' 'sha256-CU/zEhdJShlmsA6CoooXEUvJQFVYq8ThJzd0r9sCKwI=' 'sha256-CbtQ6ujyOIihCmA1QVUyOHuS7QmCH3g74Fyhx5QvYo0=' 'sha256-CmSS5TsoavTsiRuIAIlHSNQPC8wQChroXXwAKObM/iA=' 'sha256-CsFQtK8V0Eq7YHkGpWA93ukDeJwJ/Udowa62mg90oxY=' 'sha256-Dkcn920WCH+j7w0gGZ9Eb98wEag3xKTPk3BZemKyNr4=' 'sha256-EGq0ZSC4E2cu/x99pr2/takRchSqrWN14cpCayj6H9Y=' 'sha256-H7btt/BW67ZhLfOvRTF/hN0Ij9s80oSoyR+ptBcF7UI=' 'sha256-H9NK0wyOc4rEvKvEAXHwx8unXWdGyYkiAMRkbjwwMgw=' 'sha256-HASGF9gg4vwtmEvivQ9vJpLk2K5ZvV4IDahsxrebahQ=' 'sha256-LgsbZeBbm4MSPhAZaKhxKSUau0BLibJcUbMibqLxVmg=' 'sha256-MoAGwk9J0JoHTgqYDooagZHyQbaGFAq7YTbMyPhLqFQ=' 'sha256-NaPX/uEHzfPMqA47sZe0dnxPe017Vb8cfizvGNkm3MQ=' 'sha256-OzmcyqUNTbjXIUH0w5EI0uW1KzvoYwO1GOseIWaAORo=' 'sha256-PLI/gBJLZNWMqsUoOfRW7GJ8tbtoE4FG6gwpS3uWSzQ=' 'sha256-PxctguhvEql22HS7iJiiFVx2qKK4Bx7OkEUbVFqIOXU=' 'sha256-S7z4Me+uS/xNwp67MnHh2KBEq0bVJBbs6acFtEqpoNo=' 'sha256-U7tZZ6HTpuVZM3Domt6VSotYLY6olNa8OAtGnMF3Y3M=' 'sha256-Uuz75Ywh1K2FHOE+jG6xdEmhFxDUfrqPygOwWvtahCU=' 'sha256-Ya4ZUiE1pXXltvaUF3G23z+ryR2SEZYP7t8tFcbM03k=' 'sha256-ZrGV4LFYzNyuqFAuuW8LRRpUPTXb9k94YxPQDldIOq4=' 'sha256-aziFE4/opYCQ3zvlnjUg3yzq1YmXP9yCklE0rMHZytg=' 'sha256-c0BAXUFW+y+a50tTAevPLhuR8TRQJNXVRzN4lXiSX4Q=' 'sha256-c1xY/oroAC0t4o+rBHRARTr/FAKtepoix/mTdQlc7X4=' 'sha256-dEZ4WS2kRlvYMAtzllC6uxCUQQRyR9n3gxmqOZ7omYQ=' 'sha256-dLcFS8O9X6aI5MT1bDhlOdwgzAmgf9ZtM2W1P0sf650=' 'sha256-epmyx2uWsC9vekua4emH7rb+0++t8uyoOyODIVz7rp8=' 'sha256-gV1K1d0Hp0rbAwm84ORqRyNkdmiSJ7eDPUQsMnR879I=' 'sha256-hIjHPj++QkoZtV/zc36GRC2Fu0Au2R9Lw81eWG6IFbc=' 'sha256-iUvouBIfiNhBXCekZ8vSGLm07cfiTRsz6fgNdKvP3y8=' 'sha256-j4XQ3gA3AuaRMH9fqxcjGwB7/2sRBJhMyk3w8wR11TQ=' 'sha256-j7LML1Wq5hOI1B/LPHzXTbzEbaNnA6BpBE7NjpqmsEw=' 'sha256-jYdZQ9n40O0V2ccthhL6BJYU52AgF9aWKgD5FlIOBso=' 'sha256-k0G0cTdPRAhp7hJsqdP05+q60hk4RpoaNlvKyMB1KmQ=' 'sha256-lxpQTcrq7tSBzZf5EdSzV7K6kvHxE2lHmI3+JA6uDl8=' 'sha256-nlEux4RsJxtLK2jIy6Fv8DhMM8MsWDYK+iOmQThRnio=' 'sha256-pjSkjeOw27jFOFx/ErjxQoTnv2QKNZ8TRGC9N8uogxw=' 'sha256-qPMqge8cLo0TE33FUz5Z+n8fbxGc+4Rt/XR0OeOgQK8=' 'sha256-sj84UcnusqKsMtnccNj/TmNzUTihXKcaZ23tYy4V+rY=' 'sha256-vVR7OmhxS2+FhBiASK2zZUtyjb/iDsSomp8v1WvxbxQ=' 'sha256-yleO5AdpWl8Gk4S9lx12gGzjaZvsgpPCcSA2FfC+r9g=' 'sha256-zPCAd/2Px1quHwujn8atG7CDeWlgdSKYpBSg9pq8q90='; style-src 'self'" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()" always;
  add_header X-Frame-Options "DENY" always;

  # Prefer exact files / clean URLs (no trailing slash)
  try_files $uri $uri/ $uri.html =404;

  # True 404 status with locale-aware bodies
  error_page 404 /404.html;
  location = /404.html {
    internal;
  }

  # English unmatched paths should use the English 404 document
  location ^~ /en/ {
    try_files $uri $uri/ $uri.html /en/404.html;
    error_page 404 /en/404.html;
  }

  location = /en/404.html {
    internal;
  }
}
