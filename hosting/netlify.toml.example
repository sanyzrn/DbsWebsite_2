# host-specific deployment config — replace with the equivalent for a new host if migrating
# Netlify port of the Apache host rules (publish = dist).

[build]
  publish = "dist"
  command = "npm run build"

# Canonical: temporary Netlify subdomain → apex (update hostname if it changes)
[[redirects]]
  from = "https://YOUR-SITE.netlify.app/*"
  to = "https://dbsstudio.ir/:splat"
  status = 301
  force = true

# True 404s (filesystem first; these only apply when no file matches)
[[redirects]]
  from = "/en/*"
  to = "/en/404.html"
  status = 404

[[redirects]]
  from = "/*"
  to = "/404.html"
  status = 404

[[headers]]
  for = "/*"
  [headers.values]
    # CSP: self + Formspree; inline for FOUC/JSON-LD; self-hosted fonts — see hosting/README.md
    Content-Security-Policy = "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://api.github.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests; script-src 'self' 'sha256-09jRdXqN2Xf4PNZvei2S6ZsjbWIEK1XwO8z4JVBIQ6M=' 'sha256-2CgJa885iO2C2ezif8NDoG4NN2juHHFHes3MY37vIUw=' 'sha256-3B6Vcs4DfL+MoBy3RY2grG/WFEFXt67+JQW0Lysi3GM=' 'sha256-4tmCTbRpqMNwM9xxBaa0L8UO0Vx0fe6s5mMEXXIjmXs=' 'sha256-5DO1QWHex49cYVA6UaUEnxX7NKZViJyq1daPUR6jGS8=' 'sha256-63XE6Wp0sIr2ZnQPSQTKH2K+2c9JUNn/oozS8B3Aj10=' 'sha256-66ldv3mKUGu2rxhuf0BWjp05Fa47gmKWYQbXdCmeflk=' 'sha256-7FWjXf/05/n9V6JP919vYNbKApIjImKYDrWQqT4/XiA=' 'sha256-8XktaQ9alAO1aMn1MPd47PAfprIwapPDpkfleWDZqwM=' 'sha256-CHQQzri1Mb1tuNFCRBQvYevjxAIQDPTg5dIVMa72Z9A=' 'sha256-CbHN/QJmTv0bRNDzuzY9E4BVn79mpg1aTdDbNRBsrIo=' 'sha256-D/aR4f5roStHqsFLeOv1iNceTLFWhiGEiEmTtbgF9fY=' 'sha256-DvkusBdIbcddvdoTg6gErDOGdiel8+uPQDJ505YiZSA=' 'sha256-Dyec9BPh5awIiFhC3B8xTAqtgcAHWHXMtrS+zPPy2fE=' 'sha256-EBzfvmRnS4drBqnD2Mp1mSU8cyYvO7C0yMPllgptq7I=' 'sha256-EgCPwp3mgiQ8GF+AMA3+iCkqBDYPimaULkIVGSx8dTk=' 'sha256-GX2V1c3WCvXB4oxA5VbuyRiQ+8VFPqN45yzvRqb+lpg=' 'sha256-Is+csSuoawxfYY0f8uDQSqy2j4+uMLqEUZB+FoC6pSU=' 'sha256-K3BNqoG2IxNbQfdhc28C3rdBPyuf5GiczZsTLV/WMSg=' 'sha256-K7D+CXkMf8mA5zwHCPwBV0obu1wXYzl3MTxQkVJsJYk=' 'sha256-L3whXbKdR9N8P1T3Ph/AZg9hsDfFrstXNUvcMdHJvcM=' 'sha256-M2qe2svPhxSSdorcHh51JY0MrJu2dGgCzmBIVyQMdH0=' 'sha256-OpLZNPceknEWjvqCzzGLXeFkOGkIsJOJeM/ymA0kjzg=' 'sha256-OyPQnemBaV9GQY+ozKIMOn5XLJBVvz8iCTNVfr2/A0s=' 'sha256-PwXpA/KBPp7v5KBKA1xurwtsqrEtLbAXw5fogJ4lytY=' 'sha256-QdP8hbUinqS7OutvgoioBLMRdJIOh9B+o4DWvKMxFY8=' 'sha256-Qv2XnZlZMSuyBo2P6enzniBv5+qP5rH7Na6l5BmBN9I=' 'sha256-SWJbhObI7Hpl8EdY6PlAOthlaSGWTgKou6Mieppkm/M=' 'sha256-SqDiY3iIdHMUFsyCJPCv6L7lFE44XQw0400nZd7V1X0=' 'sha256-T9xay0WWC7jcX9CMjh4ojGU2+Mk0jGG3Tcw/UsDcPFo=' 'sha256-TGA1PRYxbfc2msvUtX8tK+tgM6vBqx8W1oHaomb+OnY=' 'sha256-UX