# host-specific deployment config — replace with the equivalent for a new host if migrating
# Netlify port of the Apache host rules (publish = dist).

[build]
  publish = "dist"
  command = "npm run build"

# Canonical: temporary Netlify subdomain → apex (update hostname if it changes)
[[redirects]]
  from = "https://YOUR-SITE.netlify.app/*"
  to = "https://saeedzarrini.ir/:splat"
  status = 301
  force = true

# True 404s (filesystem first; these only apply when no file matches)
[[redirects]]
  from = "/en/*"
  to = "/en/404.html"
  status = 404

[[redirects]]
  from = "/*"
  to = "/404.html"
  status = 404

[[headers]]
  for = "/*"
  [headers.values]
    # CSP: self + Formspree; inline for FOUC/JSON-LD; self-hosted fonts — see hosting/README.md
    Content-Security-Policy = "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests; script-src 'self' 'sha256-+uhfi5AJg+WMN4NjABDuzxTI25fpNBimupxFV9w9qE4=' 'sha256-1TyTUiUQaYnUOSkxfWN/m2BQXkyVQi80O22kk9Fe5e0=' 'sha256-3/CLqvwZDS3ANP6V5lVxHNnArpZL9zWEQInyAwbbeyo=' 'sha256-8St1i8fCnLqTaHba1ndVXDmVUBwyya5nQIPknB/MMSE=' 'sha256-CsFQtK8V0Eq7YHkGpWA93ukDeJwJ/Udowa62mg90oxY=' 'sha256-Dkcn920WCH+j7w0gGZ9Eb98wEag3xKTPk3BZemKyNr4=' 'sha256-EGq0ZSC4E2cu/x99pr2/takRchSqrWN14cpCayj6H9Y=' 'sha256-FuUtdpNIDVkVJYSSaEil+eY78QLAi+PIjhJS72ovpIo=' 'sha256-H7btt/BW67ZhLfOvRTF/hN0Ij9s80oSoyR+ptBcF7UI=' 'sha256-NaPX/uEHzfPMqA47sZe0dnxPe017Vb8cfizvGNkm3MQ=' 'sha256-OzmcyqUNTbjXIUH0w5EI0uW1KzvoYwO1GOseIWaAORo=' 'sha256-Ya4ZUiE1pXXltvaUF3G23z+ryR2SEZYP7t8tFcbM03k=' 'sha256-aziFE4/opYCQ3zvlnjUg3yzq1YmXP9yCklE0rMHZytg=' 'sha256-c0BAXUFW+y+a50tTAevPLhuR8TRQJNXVRzN4lXiSX4Q=' 'sha256-c1xY/oroAC0t4o+rBHRARTr/FAKtepoix/mTdQlc7X4=' 'sha256-dLcFS8O9X6aI5MT1bDhlOdwgzAmgf9ZtM2W1P0sf650=' 'sha256-gV1K1d0Hp0rbAwm84ORqRyNkdmiSJ7eDPUQsMnR879I=' 'sha256-iQ+bTuqkvyfrfwcse+xhfV5nmU/dbwINq8auWnJDOf4=' 'sha256-j4XQ3gA3AuaRMH9fqxcjGwB7/2sRBJhMyk3w8wR11TQ=' 'sha256-k0G0cTdPRAhp7hJsqdP05+q60hk4RpoaNlvKyMB1KmQ=' 'sha256-lxpQTcrq7tSBzZf5EdSzV7K6kvHxE2lHmI3+JA6uDl8=' 'sha256-qPMqge8cLo0TE33FUz5Z+n8fbxGc+4Rt/XR0OeOgQK8=' 'sha256-sj84UcnusqKsMtnccNj/TmNzUTihXKcaZ23tYy4V+rY=' 'sha256-yleO5AdpWl8Gk4S9lx12gGzjaZvsgpPCcSA2FfC+r9g=' 'sha256-zPCAd/2Px1quHwujn8atG7CDeWlgdSKYpBSg9pq8q90='; style-src 'self'"
    X-Content-Type-Options = "nosniff"
    Referrer-Policy = "strict-origin-when-cross-origin"
    Permissions-Policy = "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()"
    X-Frame-Options = "DENY"
    # No Strict-Transport-Security until the permanent host is locked in.
