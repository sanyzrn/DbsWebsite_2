# DBS Studio idea archive — standalone public static page.
# Does not alter the rest of the website, its React router or Apache rules.
DirectoryIndex index.html
Options -Indexes
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  <Files "ideas.json">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
</IfModule>
